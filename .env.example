# Cursor API key for CursorSDKProvider (Dashboard → Integrations).
# Not required when provider=mock.
# NEVER commit a real key. Copy this file to `.env` (gitignored) and fill locally:
#   cp .env.example .env
# Verify presence without printing the secret:
#   python -c "import os; from dotenv import load_dotenv; load_dotenv(); print('set' if os.getenv('CURSOR_API_KEY') else 'missing')"
# Confirm Git ignores .env:
#   git check-ignore -v .env
CURSOR_API_KEY=

# Optional override of default config path
# AI_LAB_CONFIG=config/default.yaml

# Optional Brave Search API key for research.backend=web with engine=brave.
# Not required for mock/replay, or for web+duckduckgo.
# BRAVE_SEARCH_API_KEY=
